[gd_scene format=3]

[ext_resource type="Script" path="res://game/player/player.gd" id="1_player"]
[ext_resource type="Script" path="res://game/weapons/weapon_data.gd" id="2_weapon_data"]
[ext_resource type="Resource" path="res://game/weapons/data/rifle.tres" id="3_rifle"]
[ext_resource type="Resource" path="res://game/weapons/data/pistol.tres" id="4_pistol"]
[ext_resource type="Resource" path="res://game/player/movement/default.tres" id="5_movement"]
[ext_resource type="PackedScene" path="res://game/characters/character.tscn" id="6_character"]
[ext_resource type="Script" path="res://game/player/view_model.gd" id="7_view_model"]
[ext_resource type="Script" path="res://game/player/hud.gd" id="8_hud"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
resource_local_to_scene = true
radius = 0.4
height = 1.8

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_player"]
properties/0/path = NodePath(".:net_position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:net_yaw")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:net_pitch")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:net_velocity")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath(".:net_state")
properties/4/spawn = true
properties/4/replication_mode = 1
properties/5/path = NodePath(".:net_height")
properties/5/spawn = true
properties/5/replication_mode = 1

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 7
script = ExtResource("1_player")
weapons = Array[ExtResource("2_weapon_data")]([ExtResource("3_rifle"), ExtResource("4_pistol")])
movement = ExtResource("5_movement")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="Character" parent="." instance=ExtResource("6_character")]

[node name="Head" type="Node3D" parent="."]
position = Vector3(0, 1.64, 0)

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.64, 0)
fov = 90.0
near = 0.02
far = 600.0

[node name="ViewModel" type="Node3D" parent="Camera3D"]
script = ExtResource("7_view_model")

[node name="Synchronizer" type="MultiplayerSynchronizer" parent="."]
replication_interval = 0.0166
replication_config = SubResource("SceneReplicationConfig_player")

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("8_hud")

[node name="Overlay" type="Control" parent="HUD"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Status" type="Label" parent="HUD/Overlay"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 28.0
offset_top = -76.0
offset_right = 300.0
offset_bottom = -46.0
grow_vertical = 0
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.6)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 22
text = "HP 100"

[node name="Ammo" type="Label" parent="HUD/Overlay"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -420.0
offset_top = -64.0
offset_right = -28.0
offset_bottom = -24.0
grow_horizontal = 0
grow_vertical = 0
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.6)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 28
text = "RIFLE   30 / 30"
horizontal_alignment = 2

[node name="Speed" type="Label" parent="HUD/Overlay"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -80.0
offset_top = -48.0
offset_right = 80.0
offset_bottom = -22.0
grow_horizontal = 2
grow_vertical = 0

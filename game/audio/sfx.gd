const SURFACE_NAMES := [&"", &"concrete", &"metal", &"flesh"]
## Collider / material names that should sound like metal.
const METAL_HINTS := ["metal", "container", "corrugated", "barrel", "propane", "generator", "shelves", "utility"]


static func enabled() -> bool:
	return DisplayServer.get_name() != "headless"


static func pick(list: Array) -> AudioStream:
	return list[randi() % list.size()] if not list.is_empty() else null


## Non-positional sound (the local player's own gun, UI).
static func play_2d(owner: Node, stream: AudioStream, volume_db := 0.0, pitch_jitter := 0.04, bus := WORLD_BUS) -> void:
	if not enabled() or stream == null or owner == null or not owner.is_inside_tree():
		return
	var player := AudioStreamPlayer.new()
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.bus = bus
	owner.add_child(player)
	player.finished.connect(player.queue_free)
	player.play()


## Positional sound at `position`, parented to `parent` (usually the map).
static func play_3d(parent: Node, stream: AudioStream, position: Vector3, volume_db := 0.0,
		unit_size := 6.0, max_distance := 80.0, pitch_jitter := 0.05) -> void:
	if not enabled() or stream == null or parent == null or not parent.is_inside_tree():
		return
	var player := AudioStreamPlayer3D.new()
	player.stream = stream
	player.volume_db = volume_db
	player.unit_size = unit_size
	player.max_distance = max_distance
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.bus = WORLD_BUS
	player.physics_interpolation_mode = Node.PHYSICS_INTERPOLATION_MODE_OFF
	parent.add_child(player)
	player.global_position = position
	player.finished.connect(player.queue_free)
	player.play()


## A looping player kept alive by its owner (wind, slide). Starts silent.
static func make_loop(owner: Node, stream: AudioStream, positional: bool) -> Node:
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	var player: Node
	if positional:
		var p3 := AudioStreamPlayer3D.new()
		p3.unit_size = 4.0
		p3.max_distance = 40.0
		p3.bus = WORLD_BUS
		p3.stream = stream
		p3.volume_db = -80.0
		player = p3
	else:
		var p2 := AudioStreamPlayer.new()
		p2.bus = WORLD_BUS
		p2.stream = stream
		p2.volume_db = -80.0
		player = p2
	owner.add_child(player)
	return player


## Classifies what a ray hit, for footsteps and impacts.
static func surface_of(collider: Object) -> Surface:
	if collider == null:
		return Surface.NONE
	if collider.has_method("take_damage"):
		return Surface.FLESH
	var hint := (collider as Node).name.to_lower() if collider is Node else ""
	if collider is CSGShape3D:
		var material: Material = collider.get("material")
		if material:
			hint += " " + material.resource_path.to_lower()
	for word: String in METAL_HINTS:
		if word in hint:
			return Surface.METAL
	return Surface.CONCRETE


## Surface under (or beside) a point, by a short ray cast against the world.
static func surface_at(space: PhysicsDirectSpaceState3D, from: Vector3, to: Vector3, exclude: Array[RID]) -> Surface:
	var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(from, to, 0b1, exclude))
	return surface_of(hit.collider) if not hit.is_empty() else Surface.CONCRETE

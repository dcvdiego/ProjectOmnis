# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Binary assets (never touch line endings). If the asset folder grows a lot,
# move these to Git LFS (see docs/contributing.md#assets).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.hdr binary
*.exr binary
*.glb binary
*.bin binary
*.fbx binary
*.blend binary
*.ogg binary
*.wav binary
